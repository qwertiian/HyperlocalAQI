# Copy this file to .env and fill in as you register for each service.
# Nothing here is required to run the sample-data demo.

# --- Phase 1: ground + weather data ---
OPENAQ_API_KEY=               # https://explore.openaq.org/register
DATA_GOV_IN_API_KEY=          # https://data.gov.in -> My Account -> API keys
CITY_NAME=Nagpur
CITY_LAT=21.1458
CITY_LON=79.0882
CITY_BBOX_MIN_LON=78.90
CITY_BBOX_MIN_LAT=21.00
CITY_BBOX_MAX_LON=79.20
CITY_BBOX_MAX_LAT=21.25

# --- Database (Supabase Postgres + PostGIS) ---
# Free project: https://supabase.com/dashboard -> New Project
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=                 # postgres connection string from Supabase settings -> Database
# If left blank, ingestion + modeling scripts fall back to local SQLite at data/aqi.db

# --- Phase 4: satellite data (Google Earth Engine) ---
GEE_SERVICE_ACCOUNT_JSON=     # path to your GEE service-account key file
GEE_PROJECT_ID=

# --- Phase 3: advisory LLM (Local Ollama / Grounded Template) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b        # e.g. llama3.1:8b or llama3.2
ADVISORY_LLM_PROVIDER=ollama    # 'ollama' for local LLM rephrasing, or 'template' for instant deterministic rules
# Note: Gemini cloud API is disabled per project plan in favor of free zero-limit local Ollama.

# --- Backend ---
PORT=4000
